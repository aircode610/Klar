# Klar frontend environment. Copy to .env.local for local development.

# Two modes:
#
# (A) Direct mode — frontend and backend on the same origin (e.g. same
#     localhost). Set NEXT_PUBLIC_API_URL to the absolute backend URL:
#       NEXT_PUBLIC_API_URL=http://localhost:8000
#
# (B) Same-origin proxy mode — recommended for cross-origin / ngrok / iOS
#     where third-party-cookie blocking would otherwise break login. The
#     frontend hits /api/* on its own origin and Next.js rewrites those to
#     the backend (see next.config.ts → rewrites() and BACKEND_URL below):
#       NEXT_PUBLIC_API_URL=/api
#       BACKEND_URL=https://your-backend-ngrok.ngrok-free.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Upstream backend URL — used ONLY server-side by next.config.ts → rewrites().
# Not NEXT_PUBLIC_, so it never reaches the browser bundle. Leave unset in
# direct mode (A); set it when running in same-origin proxy mode (B).
# BACKEND_URL=https://your-backend-ngrok.ngrok-free.app

# Default UI language: en | de | fa | tr | ar | uk (sent to the backend as ?lang=)
NEXT_PUBLIC_DEFAULT_LANG=en
