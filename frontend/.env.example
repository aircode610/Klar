# Klar frontend environment. Copy to .env.local for local development.

# Base URL of the FastAPI backend (routers mounted at /letters, /actions, /rag,
# /auth). No /api prefix, no trailing slash. Auth is cookie-based.
#
# For LAN access (e.g. testing the PWA on a phone), use this machine's IP
# instead of "localhost". On macOS: `ipconfig getifaddr en0`. Make sure the
# backend's ALLOWED_ORIGINS includes http://<IP>:3000, and start the dev
# server with `next dev -H 0.0.0.0` (already configured in package.json).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default UI language: en | de | fa | tr | ar | uk (sent to the backend as ?lang=)
NEXT_PUBLIC_DEFAULT_LANG=en
