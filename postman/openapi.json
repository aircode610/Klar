    "/api/letters/upload": {
      "post": {
        "tags": [
          "letters"
        ],
        "summary": "Upload Letter",
        "description": "Save the upload, create a Letter row with status='uploaded', return its id.\n\nExtraction runs LATER via GET /api/letters/{id}/process (SSE).\n\nValidation:\n- Declared Content-Type must be in ACCEPTED_MIMES.\n- File MUST match its declared type via magic-bytes inspection \u2014 defends\n  against malicious renames (e.g. an executable announced as image/jpeg).\n- 10 MB max size per spec.",
        "operationId": "upload_letter_api_letters_upload_post",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lang"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_letter_api_letters_upload_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LetterUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/letters/{letter_id}/extract": {
      "post": {
        "tags": [
          "letters"
        ],
        "summary": "Extract Letter",
        "description": "Synchronous extraction \u2014 runs the structured Qwen call inline and\nreturns the populated LetterResponse. Used by clients that don't want SSE.\n\nLong-form fields (explanation, response_draft, checklist, citations) are\nNOT populated here \u2014 only the SSE endpoint generates those.",
        "operationId": "extract_letter_api_letters__letter_id__extract_post",
        "parameters": [
          {
            "name": "letter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
