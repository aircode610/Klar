    "/api/letters/{letter_id}/process": {
      "get": {
        "tags": [
          "letters"
        ],
        "summary": "Process Letter",
        "description": "SSE stream: orchestrates extraction + long-form generation.\n\nAuth is via the session cookie (set by /api/auth/login). EventSource\ncallers must construct with `withCredentials: true` so the cookie travels\non the SSE GET. The spec's `?token=` query-param is intentionally NOT\nsupported \u2014 tokens-in-URL get logged to access logs and browser history.\nSee docs/02-backend.md \"Modifications\" section.\n\nNOTE: we do NOT pass the injected `db` to the generator \u2014 FastAPI closes\nit as soon as this handler returns. The generator opens and owns its own\nSession for the stream's lifetime.",
        "operationId": "process_letter_api_letters__letter_id__process_get",
        "parameters": [
          {
            "name": "letter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Letter Id"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lang"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
