      "DocumentCategory": {
        "type": "string",
        "enum": [
          "health_insurance",
          "other_insurance",
          "banking",
          "tax",
          "immigration",
          "education",
          "housing",
          "utilities",
          "employment",
          "government_benefits",
          "pension",
          "broadcast_fee",
          "civic",
          "legal_debt",
          "other"
        ],
        "title": "DocumentCategory",
        "description": "Closed vocabulary for letter classification.\n\nCovers the institutional landscape for both international students and\nworking professionals in Germany. Use OTHER only when the letter genuinely\ndoes not fit any defined bucket."
      },
