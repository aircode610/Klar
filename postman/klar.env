# Klar API — Posting environment variables
# Loaded automatically when you run `api klar`.

# --- Server ---
BASE_URL=http://localhost:8000

# --- Auth defaults (override in TUI per request) ---
EMAIL=test@example.com
PASSWORD=demo-password-123
NEW_PASSWORD=brand-new-password-456
LANGUAGE=en

# --- Captured at runtime ---
# Paste the value from the klar_session cookie after /api/auth/login.
# (Posting also auto-stores cookies between requests in the same session.)
KLAR_SESSION=

# Captured from POST /api/auth/forgot-password response (dev_reset_token field).
RESET_TOKEN=

# --- Resource IDs ---
# Populate after creating data. Posting also prompts for these as path params
# whenever a request URL contains {letter_id} or {action_id}.
LETTER_ID=
ACTION_ID=

# --- RAG defaults ---
RAG_QUERY=Mahnung deadline phrasing
RAG_TOP_K=4
RAG_INSTITUTION=
