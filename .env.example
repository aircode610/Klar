# Klar frontend environment. Copy to .env.local for local development.

# Base URL of the FastAPI backend (routers are mounted at /letters, /actions, /rag).
# No /api prefix, no trailing slash. Empty string + mock mode = MSW intercepts.
NEXT_PUBLIC_API_URL=http://localhost:8000

# mock | live  — "mock" serves fixtures via MSW; "live" hits NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock

# Default UI language: en | de | fa | tr | ar | uk (sent to the backend as ?lang=)
NEXT_PUBLIC_DEFAULT_LANG=en
