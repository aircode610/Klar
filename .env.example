# Klar environment. Copy to .env.local for local development.

# Base URL of the backend API (without the /v1 suffix).
NEXT_PUBLIC_API_BASE=https://api.klar.app

# mock | live  — "mock" serves fixtures via MSW; "live" hits NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_API_MODE=mock

# Default UI language before the user chooses one: en | de | fa | tr | ar | uk
NEXT_PUBLIC_DEFAULT_LANG=en
