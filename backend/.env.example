# =============================================================
# Klar backend — environment variables
# =============================================================
# Variable naming follows docs/02-backend.md spec. Legacy names
# (LLM_API_KEY, LLM_BASE_URL, CORS_ORIGINS) are still accepted
# as fallbacks for backwards compatibility.

# --- LLM provider (OpenAI-compatible API) ---
# WaveSpeed example:
#   QWEN_API_KEY=sk-ws-...
#   QWEN_API_BASE=https://api.wavespeed.ai/v1
# DashScope (Alibaba) example:
#   QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-ws-replace-me
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# --- Persistence ---
DATABASE_URL=sqlite:///./data/klar.db
UPLOAD_DIR=./uploads

# --- ChromaDB (embedded, persistent) ---
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=klar_knowledge

# --- Auth ---
# Used to derive session token secrets — should be a 32+ byte random string.
JWT_SECRET=change-me-to-a-32-byte-random-string-in-prod
SESSION_TTL_HOURS=168
RESET_TOKEN_TTL_MINUTES=15
COOKIE_NAME=klar_session
COOKIE_SECURE=false           # set true on HTTPS (production)
COOKIE_SAMESITE=lax           # lax | strict | none

# Dev/hackathon: expose reset tokens in /api/auth/forgot-password response
# so the frontend can test end-to-end without SMTP. SET TO false IN PROD.
DEV_AUTH_EXPOSE_RESET_TOKEN=true

# --- App ---
APP_ENV=dev
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://klar-app.vercel.app
