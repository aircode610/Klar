# LLM provider (OpenAI-compatible API).
# Default targets WaveSpeed AI, which proxies Qwen3.7-Plus.
# Direct DashScope alternative:
#   LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
LLM_API_KEY=sk-ws-replace-me
LLM_BASE_URL=https://api.wavespeed.ai/v1
LLM_MODEL=qwen3.7-plus

# Database
DATABASE_URL=sqlite:///./data/klar.db

# ChromaDB (embedded, persistent)
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=klar_knowledge

# App
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
